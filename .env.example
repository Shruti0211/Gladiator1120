# Akamai/Linode Object Storage (S3-compatible)
S3_ENDPOINT_URL=https://<region>.linodeobjects.com
S3_REGION=<region>
S3_BUCKET=<bucket-name>
S3_ACCESS_KEY=<object-storage-access-key>
S3_SECRET_KEY=<object-storage-secret-key>

# Akamai inference endpoint (use the base URL, API key and model supplied by the workshop)
AKAMAI_INFERENCE_BASE_URL=https://<your-akamai-inference-endpoint>/v1
AKAMAI_INFERENCE_API_KEY=<your-inference-api-key>
AKAMAI_INFERENCE_MODEL=<model-name>
